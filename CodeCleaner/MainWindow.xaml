<Window x:Class="CodeCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodeCleaner"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FF187A48">
        <Label Content="Code Cleaner" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{x:Null}" FontSize="30" FontWeight="Bold"/>
        <Button x:Name="TallozasButton" Content="Fájl kiválasztása" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" RenderTransformOrigin="0.535,-1.427" Margin="0,61,0,0" FontStyle="Italic" Click="TallozasButton_Click"/>
        <TextBox x:Name="KodTextBox"
         VerticalAlignment="Stretch"
         AcceptsReturn="True"
         TextWrapping="NoWrap"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         HorizontalAlignment="Stretch"
         Margin="0,100,0,0" TextChanged="KodTextBox_TextChanged"/>
    </Grid>
</Window>
