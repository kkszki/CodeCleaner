<Window x:Class="CodeCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CodeCleaner"
        mc:Ignorable="d"
        Title="Code Cleaner"
        Height="600"
        Width="1000"
        Loaded="Window_Loaded">

    <Grid Background="#FF187A48">

        <Label Content="Code Cleaner"
               Margin="0,3,0,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Background="{x:Null}"
               FontSize="30"
               FontWeight="Bold"/>

        <Button x:Name="TallozasButton"
               Content="Fájl kiválasztása"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontSize="20"
               Margin="0,61,0,0"
               FontStyle="Italic"
               Click="TallozasButton_Click"/>

        <Grid Width="220"
              Height="35"
              Margin="0,98,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">

            <TextBox x:Name="TemaTextBox"
                     FontSize="20"
                     VerticalContentAlignment="Center"
                     Background="White"
                     Padding="5,0,5,0"
                     TextChanged="TemaTextBox_TextChanged"/>

            <TextBlock Text="Adja meg a témát"
                       Foreground="Gray"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="7,0,0,0"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TemaTextBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Button x:Name="Bekuld"
                Content="AI elemzés"
                Width="150"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,145,0,0"
                FontSize="18"
                FontWeight="Bold"
                Background="#FF124D32"
                Foreground="White"
                Cursor="Hand"
                Click="Bekuld_Click"/>

        <Grid Margin="10,200,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="Eredeti kód"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                <TextBox x:Name="KodTextBox"
                         Grid.Row="1"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontSize="14"
                         TextChanged="KodTextBox_TextChanged"/>
            </Grid>

            <Grid Grid.Row="0" Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Content="AI által javított kód"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                <TextBox x:Name="JavitottKodTextBox"
                         Grid.Row="1"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontSize="14"/>
            </Grid>

            <Button x:Name="MentesButton"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Content="Mentés"
                    Width="150"
                    Height="40"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#FF124D32"
                    Foreground="White"
                    Cursor="Hand"
                    Click="MentesButton_Click"/>
        </Grid>

    </Grid>
</Window>